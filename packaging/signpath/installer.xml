<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "installer". The workflow uploads the Inno Setup
     installer as a GitHub artifact, which arrives as a zip. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Stinkshot-${version}-x64-setup.exe" product-name="Stinkshot" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
