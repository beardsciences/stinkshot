<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "exe". The workflow uploads stinkshot.exe as a
     GitHub artifact, which arrives as a zip. Paste into SignPath, Project, Artifact
     Configurations. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="stinkshot.exe" product-name="Stinkshot" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
